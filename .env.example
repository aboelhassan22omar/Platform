# =============================================================================
# منصة عمرو محروس التعليمية — Amr Mahrous Educational Platform
# Environment template. Copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# NEVER commit a filled-in .env. Rotate every secret before going to production.
# =============================================================================

# -----------------------------------------------------------------------------
# Host ports
#
# These were chosen after checking which ports were already bound on the build
# machine (80, 8080, 5433, 1521, 9007 and others were occupied). The 7xxx block
# was free. Change them freely — nothing internal depends on these numbers,
# they only control what is published to the host.
# -----------------------------------------------------------------------------
PROXY_HTTP_PORT=7080
PROXY_HTTPS_PORT=7443
FRONTEND_PORT=7300
BACKEND_PORT=7400

# Infrastructure ports. In production these should NOT be published at all —
# see docker-compose.prod.yml, which keeps them on the internal network only.
POSTGRES_PORT=7432
REDIS_PORT=7379
MINIO_API_PORT=7900
MINIO_CONSOLE_PORT=7901

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
# Public origin of the site, used for absolute links, CORS and payment returns.
PUBLIC_SITE_URL=http://localhost:7080
# Origin the browser uses to reach the API.
PUBLIC_API_URL=/api

# -----------------------------------------------------------------------------
# Platform identity (change these to reuse the same product for another teacher)
# -----------------------------------------------------------------------------
PLATFORM_NAME=منصة مستر عمرو محروس التعليمية
TEACHER_NAME=مستر عمرو محروس
SUBJECT_KEY=history
SUBJECT_NAME=التاريخ
NEXT_PUBLIC_PLATFORM_NAME=منصة مستر عمرو محروس التعليمية
NEXT_PUBLIC_PLATFORM_SHORT_NAME=منصة عمرو محروس
NEXT_PUBLIC_PLATFORM_DESCRIPTION=منصة تعليمية تجمع الشرح والمراجعة والمتابعة في مكان واحد.
NEXT_PUBLIC_TEACHER_NAME=مستر عمرو محروس
NEXT_PUBLIC_TEACHER_SHORT_NAME=عمرو محروس
NEXT_PUBLIC_TEACHER_TITLE=مستر
NEXT_PUBLIC_TEACHER_TAGLINE=أسطورة التاريخ
NEXT_PUBLIC_SUBJECT_KEY=history
NEXT_PUBLIC_SUBJECT_NAME=التاريخ
NEXT_PUBLIC_SUBJECT_ADJECTIVE=التاريخية
NEXT_PUBLIC_LOGO_LIGHT=/brand/horus-eye-logo-light.png
NEXT_PUBLIC_LOGO_DARK=/brand/horus-eye-logo.png
NEXT_PUBLIC_LOGO_ALT=شعار المنصة التعليمية
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/
NEXT_PUBLIC_SUPPORT_WHATSAPP=201000000000
NEXT_PUBLIC_FOLLOWUP_WHATSAPP=201100000000
NEXT_PUBLIC_CONTACT_PHONE=201200000000
NEXT_PUBLIC_SUPPORT_WHATSAPP_LABEL=010X XXX XXXX
NEXT_PUBLIC_FOLLOWUP_WHATSAPP_LABEL=011X XXX XXXX
NEXT_PUBLIC_CONTACT_PHONE_LABEL=012X XXX XXXX
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:7080,http://localhost:7300,http://127.0.0.1:7080,http://127.0.0.1:7300

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=amr_platform
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=amr_platform
# Used by backend + workers inside the compose network.
DATABASE_URL=postgresql://amr_platform:change_me_in_production@postgres:5432/amr_platform?schema=public&connection_limit=10

# -----------------------------------------------------------------------------
# Redis (sessions/presence/queues)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379

# -----------------------------------------------------------------------------
# Authentication
#
# Generate each of these with:  openssl rand -hex 48
# They MUST differ from one another and MUST be rotated for production.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev_only_access_secret_replace_me_with_openssl_rand_hex_48
JWT_REFRESH_SECRET=dev_only_refresh_secret_replace_me_with_openssl_rand_hex_48
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Signs short-lived video playback tickets. Rotate independently of the above.
PLAYBACK_TOKEN_SECRET=dev_only_playback_secret_replace_me_with_openssl_rand_hex_48
PLAYBACK_TOKEN_TTL=21600
# `true` only when the site is served over HTTPS (production).
COOKIE_SECURE=false
# Leave EMPTY unless you genuinely need one cookie shared across subdomains
# (e.g. app.example.com and api.example.com), in which case set it to the
# parent domain: .example.com
#
# Do NOT set this to "localhost". A single-label Domain attribute is rejected
# or mishandled by several HTTP clients and browsers, which silently breaks
# login. An empty value produces a host-only cookie, which is what a
# single-origin deployment behind one reverse proxy wants.
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Object storage (S3-compatible)
#
# Development uses the bundled MinIO service. For production point these at
# your real S3/Spaces/R2 bucket and set S3_FORCE_PATH_STYLE accordingly.
# -----------------------------------------------------------------------------
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=amr_minio_admin
S3_SECRET_KEY=change_me_in_production
S3_BUCKET_VIDEOS=amr-videos
S3_BUCKET_PUBLIC=amr-public
S3_FORCE_PATH_STYLE=true

# Public endpoint used ONLY for presigned URLs handed to a browser.
#
# A presigned URL signs the host it was generated for, so a URL signed against
# the internal name `minio` cannot be used by a browser (it cannot resolve that
# name, and rewriting the host would break the signature).
#
# Development: internal is minio:9000, public is localhost:7900.
# Production with real S3: leave these EMPTY — they fall back to S3_ENDPOINT,
# which is already publicly reachable.
S3_PUBLIC_ENDPOINT=localhost
S3_PUBLIC_PORT=7900
S3_PUBLIC_USE_SSL=false
# Public base URL for non-sensitive assets (thumbnails, brand images).
S3_PUBLIC_BASE_URL=http://localhost:7900/amr-public

MINIO_ROOT_USER=amr_minio_admin
MINIO_ROOT_PASSWORD=change_me_in_production

# -----------------------------------------------------------------------------
# Video processing
# -----------------------------------------------------------------------------
# Comma-separated HLS ladder. Each entry is heightP:videoKbps:audioKbps.
HLS_RENDITIONS=360p:800:96,480p:1400:128,720p:2800:128,1080p:5000:192
HLS_SEGMENT_SECONDS=6
# How many transcodes one worker container runs at a time. Raise only if the
# host has the CPU headroom — ffmpeg is the heaviest thing in this stack.
VIDEO_WORKER_CONCURRENCY=1
MAX_UPLOAD_BYTES=5368709120

# -----------------------------------------------------------------------------
# Live classes (LiveKit Cloud)
#
# Create a free project at https://cloud.livekit.io -> Settings -> Keys.
# LIVEKIT_URL is the project's WebSocket URL (wss://<project>.livekit.cloud).
# The secret never reaches the browser: the API signs short-lived room tokens.
# Leave these empty and teachers can still schedule lives, but not go on air.
# -----------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: only when the API must reach LiveKit at a different address than
# browsers do (self-hosted LiveKit on the same machine). Leave empty for Cloud.
LIVEKIT_API_URL=
# Recordings are uploaded by LiveKit straight into S3_BUCKET_VIDEOS. LiveKit
# must reach that bucket over the internet: by default the S3_PUBLIC_* endpoint
# is used; set this when the S3 API lives elsewhere (e.g. https://s3.example.com).
RECORDING_S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Payments
#
# PAYMENT_PROVIDER=dev   -> local sandbox adapter, NO real money moves.
# PAYMENT_PROVIDER=paymob-> real Paymob integration, requires the keys below.
#
# The dev adapter is clearly labelled in the UI and refuses to run when
# NODE_ENV=production unless PAYMENT_ALLOW_DEV_IN_PROD=true is also set.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=dev
PAYMENT_CURRENCY=EGP
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_BASE_URL=https://accept.paymob.com

# -----------------------------------------------------------------------------
# SMS / phone verification
#
# PHONE_VERIFICATION=off     -> accounts are usable immediately (development).
# PHONE_VERIFICATION=console -> OTP is logged to the backend console ONLY.
# PHONE_VERIFICATION=sms     -> real provider, requires the credentials below.
#
# `console` never sends an SMS and the UI says so explicitly.
# -----------------------------------------------------------------------------
PHONE_VERIFICATION=off
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# -----------------------------------------------------------------------------
# Presence
#
# A student counts as "online" if the client sent an authenticated heartbeat
# within PRESENCE_TTL_SECONDS. This is an approximation of attention, not proof
# that anyone is watching the screen. See docs/operations/presence.md.
# -----------------------------------------------------------------------------
PRESENCE_TTL_SECONDS=120
PRESENCE_HEARTBEAT_SECONDS=45

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
# Coarse per-IP ceiling on auth endpoints, over a 10-minute window.
#
# Login is ALSO throttled per identifier in Redis, so raising this does not
# weaken brute-force protection for an individual account.
#
# Raise this (e.g. 300) when running the E2E suite, where every request comes
# from a single IP. Keep it low in production.
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW=600
AUTH_LOCK_SECONDS=600

# -----------------------------------------------------------------------------
# Admin bootstrap
#
# Used ONCE by `npm run bootstrap:admin` (or the compose `bootstrap` profile) to
# create the first administrator. Remove these values afterwards — the script
# refuses to overwrite an existing admin and logs an audit entry when it runs.
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULLNAME=
BOOTSTRAP_ADMIN_PHONE=

# -----------------------------------------------------------------------------
# Development seed
#
# When true, `npm run seed` inserts clearly-labelled demo students and demo
# purchases. Never enable on a production database.
# -----------------------------------------------------------------------------
SEED_DEMO_DATA=true
LOG_LEVEL=debug
