# Install as a NEW host nginx site, after DNS points these names to the server.
# Obtain a certificate for both names before enabling this TLS configuration.
server {
    listen 80;
    server_name amr.aurexis.cc storage.amr.aurexis.cc;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name amr.aurexis.cc;
    ssl_certificate /etc/letsencrypt/live/amr.aurexis.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/amr.aurexis.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 50m;
    location / {
        proxy_pass http://127.0.0.1:17080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace incoming forwarding headers: clients cannot impersonate IPs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}

# Presigned uploads authenticate themselves; do not rewrite the signed Host.
# Keep the video bucket private. Only the configured public bucket is public.
server {
    listen 443 ssl http2;
    server_name storage.amr.aurexis.cc;
    ssl_certificate /etc/letsencrypt/live/amr.aurexis.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/amr.aurexis.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 5g;
    location / {
        proxy_pass http://127.0.0.1:17900;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
