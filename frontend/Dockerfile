# =============================================================================
# Frontend — Next.js (standalone output)
#
# `output: 'standalone'` in next.config.ts emits a self-contained server with
# only the modules actually imported, which keeps the runtime image small.
# =============================================================================

FROM node:22-alpine AS deps

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts

# --- Build -------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# they must be present here rather than only at runtime.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_PRESENCE_HEARTBEAT_SECONDS
ARG NEXT_PUBLIC_PLATFORM_NAME
ARG NEXT_PUBLIC_PLATFORM_SHORT_NAME
ARG NEXT_PUBLIC_PLATFORM_DESCRIPTION
ARG NEXT_PUBLIC_TEACHER_NAME
ARG NEXT_PUBLIC_TEACHER_SHORT_NAME
ARG NEXT_PUBLIC_TEACHER_TITLE
ARG NEXT_PUBLIC_TEACHER_TAGLINE
ARG NEXT_PUBLIC_SUBJECT_KEY
ARG NEXT_PUBLIC_SUBJECT_NAME
ARG NEXT_PUBLIC_SUBJECT_ADJECTIVE
ARG NEXT_PUBLIC_LOGO_LIGHT
ARG NEXT_PUBLIC_LOGO_DARK
ARG NEXT_PUBLIC_TEACHER_IMAGE
ARG NEXT_PUBLIC_AUTH_BACKGROUND
ARG NEXT_PUBLIC_LOGO_ALT
ARG NEXT_PUBLIC_FACEBOOK_URL
ARG NEXT_PUBLIC_SUPPORT_WHATSAPP
ARG NEXT_PUBLIC_FOLLOWUP_WHATSAPP
ARG NEXT_PUBLIC_CONTACT_PHONE
ARG NEXT_PUBLIC_SUPPORT_WHATSAPP_LABEL
ARG NEXT_PUBLIC_FOLLOWUP_WHATSAPP_LABEL
ARG NEXT_PUBLIC_CONTACT_PHONE_LABEL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_PRESENCE_HEARTBEAT_SECONDS=$NEXT_PUBLIC_PRESENCE_HEARTBEAT_SECONDS
ENV NEXT_PUBLIC_PLATFORM_NAME=$NEXT_PUBLIC_PLATFORM_NAME
ENV NEXT_PUBLIC_PLATFORM_SHORT_NAME=$NEXT_PUBLIC_PLATFORM_SHORT_NAME
ENV NEXT_PUBLIC_PLATFORM_DESCRIPTION=$NEXT_PUBLIC_PLATFORM_DESCRIPTION
ENV NEXT_PUBLIC_TEACHER_NAME=$NEXT_PUBLIC_TEACHER_NAME
ENV NEXT_PUBLIC_TEACHER_SHORT_NAME=$NEXT_PUBLIC_TEACHER_SHORT_NAME
ENV NEXT_PUBLIC_TEACHER_TITLE=$NEXT_PUBLIC_TEACHER_TITLE
ENV NEXT_PUBLIC_TEACHER_TAGLINE=$NEXT_PUBLIC_TEACHER_TAGLINE
ENV NEXT_PUBLIC_SUBJECT_KEY=$NEXT_PUBLIC_SUBJECT_KEY
ENV NEXT_PUBLIC_SUBJECT_NAME=$NEXT_PUBLIC_SUBJECT_NAME
ENV NEXT_PUBLIC_SUBJECT_ADJECTIVE=$NEXT_PUBLIC_SUBJECT_ADJECTIVE
ENV NEXT_PUBLIC_LOGO_LIGHT=$NEXT_PUBLIC_LOGO_LIGHT
ENV NEXT_PUBLIC_LOGO_DARK=$NEXT_PUBLIC_LOGO_DARK
ENV NEXT_PUBLIC_TEACHER_IMAGE=$NEXT_PUBLIC_TEACHER_IMAGE
ENV NEXT_PUBLIC_AUTH_BACKGROUND=$NEXT_PUBLIC_AUTH_BACKGROUND
ENV NEXT_PUBLIC_LOGO_ALT=$NEXT_PUBLIC_LOGO_ALT
ENV NEXT_PUBLIC_FACEBOOK_URL=$NEXT_PUBLIC_FACEBOOK_URL
ENV NEXT_PUBLIC_SUPPORT_WHATSAPP=$NEXT_PUBLIC_SUPPORT_WHATSAPP
ENV NEXT_PUBLIC_FOLLOWUP_WHATSAPP=$NEXT_PUBLIC_FOLLOWUP_WHATSAPP
ENV NEXT_PUBLIC_CONTACT_PHONE=$NEXT_PUBLIC_CONTACT_PHONE
ENV NEXT_PUBLIC_SUPPORT_WHATSAPP_LABEL=$NEXT_PUBLIC_SUPPORT_WHATSAPP_LABEL
ENV NEXT_PUBLIC_FOLLOWUP_WHATSAPP_LABEL=$NEXT_PUBLIC_FOLLOWUP_WHATSAPP_LABEL
ENV NEXT_PUBLIC_CONTACT_PHONE_LABEL=$NEXT_PUBLIC_CONTACT_PHONE_LABEL

ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# --- Runtime -----------------------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app

RUN apk add --no-cache dumb-init \
    && addgroup -g 1001 -S nodejs \
    && adduser -S -u 1001 -G nodejs nextjs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV TZ=UTC

# public/ and .next/static are not bundled into the standalone output.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
