# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build output ----
dist/
build/
.next/
out/
*.tsbuildinfo

# ---- Generated Prisma client ----
# Regenerated by `prisma generate`; committing it causes noisy diffs and
# platform-specific binaries in the tree.
backend/src/generated/
workers/src/generated/

# ---- Secrets ----
# NEVER commit a filled-in .env. .env.example is the template and IS committed.
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
docker/nginx/certs/

# ---- Test artefacts ----
coverage/
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ---- Local scratch ----
tmp/
temp/
*.local
release-manifest.json
